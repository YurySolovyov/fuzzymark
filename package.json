{
  "repository": "YurySolovyov/fuzzymark",
  "name": "FuzzyMark",
  "version": "3.2.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/vue": "0.5.0",
    "fuzzaldrin-plus": "0.6.0",
    "node-vibrant": "4.0.4",
    "open-sans-fontface": "1.4.0",
    "pinia": "4.0.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">= 26.0.0",
    "pnpm": ">= 11.9.0"
  },
  "scripts": {
    "dev:frontend": "vite build --watch",
    "build": "vite build",
    "lint": "oxlint src/frontend src/backend test scripts",
    "lint:fix": "oxlint src/frontend src/backend test scripts --fix",
    "format": "oxfmt --write src/**/*.{js,vue} test/**/*.js scripts/**/*.js",
    "format:check": "oxfmt --check src/**/*.{js,vue} test/**/*.js scripts/**/*.js",
    "test": "vitest run",
    "version": "node scripts/sync-version.js"
  }
}
