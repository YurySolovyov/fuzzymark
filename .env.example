# Find both IDs in the Chrome Web Store Developer Dashboard:
# https://chrome.google.com/webstore/devconsole/
# The extension ID is on the extension page; the publisher ID is under Publisher > Settings.
CHROME_EXTENSION_ID=gppgpbipgmdlganikpmhlhpeiclokdgh
CHROME_PUBLISHER_ID=

# Enable the Chrome Web Store API and create a Web application OAuth client in Google Cloud:
# https://developer.chrome.com/docs/webstore/using-api
# Add https://developers.google.com/oauthplayground as an authorized redirect URI.
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=

# Generate this in https://developers.google.com/oauthplayground using the OAuth client above
# and the https://www.googleapis.com/auth/chromewebstore scope.
CHROME_REFRESH_TOKEN=

# Create AMO API credentials at https://addons.mozilla.org/developers/addon/api/key/
# The JWT issuer is the displayed API key and the JWT secret is the displayed API secret.
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
